    "primevue": "4.5.5",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.42",
    "vue-router": "^5.4.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@feature-sliced/steiger-plugin": "^0.8.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.4",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
